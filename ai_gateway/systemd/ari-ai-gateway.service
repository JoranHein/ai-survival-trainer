[Unit]
Description=AI Survival Trainer Ari AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ari-ai-server
EnvironmentFile=/opt/ari-ai-server/.env
ExecStart=/opt/ari-ai-server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
